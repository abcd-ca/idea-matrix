{
  "name": "idea-matrix",
  "version": "0.1.0",
  "private": true,
  "description": "Score your project ideas. A local-first matrix with no accounts and no server of its own.",
  "homepage": "https://ideamatrix.io",
  "license": "MIT",
  "author": "Andrew Blair (https://abcd.ca)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build",
    "verify": "node apps/web/scripts/fingerprint.mjs verify",
    "bump": "node scripts/bump-version.mjs",
    "test:e2e": "npm run test:e2e -w apps/web"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "typescript": "^5.9.3"
  }
}
